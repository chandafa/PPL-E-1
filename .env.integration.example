# Profil demo HTTP lokal. Gabungkan dengan .env yang DB-nya sudah benar.
# Cara otomatis dan DB terpisah: php scripts/prepare-integration.php
APP_ENV=integration
APP_DEBUG=false
APP_URL=http://127.0.0.1:8087

F1_API_ENABLED=true
F1_BASE_URL=http://127.0.0.1:4100
F1_LOGIN_PATH=/auth/login
F1_ROLE_PATH=/accounts/{accountId}/role
F1_CHECK_ACCOUNT=true
F1_TIMEOUT=3
F1_JWT_ALGO=HS256
# Harus sama dengan JWT_SECRET proses server F-1; jangan gunakan rahasia produksi.
F1_JWT_SECRET=
F1_CLAIM_AKUN_ID=accountId
F1_CLAIM_ROLE=roleCode
# Demo F-1 0feb37a tidak menerbitkan iss/aud. Pengecualian profil lokal ini
# dicatat di docs/integrasi/TEMUAN_F1_D2.md. Tanda tangan dan exp tetap wajib.
F1_JWT_ISSUER=
F1_JWT_AUDIENCE=
F1_JWT_LEEWAY=0
E1_DEV_LOGIN=false

D2_DRIVER=http
D2_BASE_URL=http://127.0.0.1:8026
D2_INVOICE_PATH=/api/v1/invoices/{invoiceId}
D2_TIMEOUT=3

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
