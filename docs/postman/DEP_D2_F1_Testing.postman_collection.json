{
  "info": {
    "name": "E-1 Integrasi repo F-1 v0.4 dan D-2 database",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Sumber instruksi docs/integrasi/README.md. Gunakan runtime terpisah. base URL dibedakan agar tidak keliru memanggil route tiruan E-1. Token dan password diisi lokal; tidak disimpan dalam Git. Runner CLI Postman tidak tersedia pada sesi ini; bukti eksekusi nyata berasal dari scripts/test-integration.mjs, bukan klaim menjalankan collection ini."
  },
  "variable": [
    {
      "key": "e1BaseUrl",
      "value": "http://127.0.0.1:8087"
    },
    {
      "key": "f1BaseUrl",
      "value": "http://127.0.0.1:4100"
    },
    {
      "key": "d2BaseUrl",
      "value": "http://127.0.0.1:8026"
    },
    {
      "key": "username",
      "value": "super.admin"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Login melalui konsumen E-1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d=pm.response.json().data; pm.collectionVariables.set('token', d.accessToken);",
              "pm.test('Identitas F-1 v0.4',()=>pm.expect(d.accountId).to.be.a('string'));",
              "pm.test('JWT tiga segmen',()=>pm.expect(d.accessToken.split('.')).to.have.lengthOf(3));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{e1BaseUrl}}/api/auth/f1/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrUsername\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "02 Invoice seed D-2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Proyek nested D-2',()=>pm.expect(pm.response.json().data.terkait.projectId).to.eql('prj-demo-001'));",
              "pm.test('Tanggal invoice seed',()=>pm.expect(pm.response.json().data.invoiceDate).to.eql('2026-10-11'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{d2BaseUrl}}/api/v1/invoices/inv-demo-sample"
      },
      "response": []
    },
    {
      "name": "03 Invoice D-2 tidak ditemukan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Kode error milik D-2',()=>pm.expect(pm.response.json().code).to.eql('INVOICE_NOT_FOUND'));\n// Amplop produsen D-2 berbeda dari amplop E-1."
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{d2BaseUrl}}/api/v1/invoices/id-tidak-dikenal-p6"
      },
      "response": []
    },
    {
      "name": "04 API E-1 dengan token F-1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{e1BaseUrl}}/api/v1/tax-invoices"
      },
      "response": []
    },
    {
      "name": "05 Token acak D-2 harus ditolak (temuan upstream, saat ini tes gagal)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer arbitrary-token"
          }
        ],
        "url": "{{d2BaseUrl}}/api/v1/invoices/inv-demo-sample"
      },
      "response": []
    }
  ]
}
