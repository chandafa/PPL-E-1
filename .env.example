APP_NAME="E-1 Pajak Proyek API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL lokal melalui Docker Compose; Laravel dijalankan di host
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=15439
DB_DATABASE=e1_pajak
DB_USERNAME=e1_app
DB_PASSWORD=e1_dev_pass

# API stateless: tanpa sesi, antrean, atau cache basis data
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Autentikasi token F-1 (JWT Bearer; Slide 2: periksa tanda tangan, iss, aud, exp) ---
# Mode lokal mandiri. Profil layanan resmi ada di .env.integration.example.
F1_API_ENABLED=false
F1_BASE_URL=http://127.0.0.1:4100
F1_LOGIN_PATH=/auth/login
F1_ROLE_PATH=/accounts/{accountId}/role
F1_CHECK_ACCOUNT=false
F1_TIMEOUT=5
# Algoritma HS256 (rahasia bersama) atau RS256 (kunci publik F-1 pada F1_JWT_PUBLIC_KEY_PATH).
# Nilai di bawah hanya untuk pengembangan lokal; ganti sesuai kesepakatan dengan F-1 (OPEN-08).
F1_JWT_ALGO=HS256
F1_JWT_SECRET=ganti-dengan-rahasia-bersama-minimal-32-karakter-dari-f1
F1_JWT_PUBLIC_KEY_PATH=
F1_JWT_ISSUER=f1-identity
F1_JWT_AUDIENCE=erp-anaheim
F1_JWT_LEEWAY=30
# Klaim token demo E-1 lokal. F-1 v0.4 memakai accountId/roleCode;
# prepare-integration.php menyesuaikannya pada profil integrasi.
F1_CLAIM_AKUN_ID=akunId
F1_CLAIM_ROLE=kodePeran

# Login tiruan F-1 untuk Postman/demo: POST /api/dev/f1/login. Nyalakan hanya di lokal.
E1_DEV_LOGIN=true

# --- Hak akses (BL-09: Admin, CEO, COO berhak sama; per aksi menunggu Q-19) ---
E1_ALLOWED_ROLES=Admin,CEO,COO
# Peran/akun layanan tambahan yang boleh membaca API-KE01-10 (konsumen E-2; menunggu OPEN-08)
E1_SUMMARY_EXTRA_ROLES=

# --- Integrasi D-2 (invoice) ---
# mock = snapshot tabel D-2 di basis data E-1; http = layanan D-2 sebenarnya
# Untuk pakai D-2 nyala: D2_DRIVER=http dan D2_BASE_URL=http://localhost:8000 (atau staging D-2).
# E-1 hanya memanggil GET /api/v1/invoices/{invoiceId} dan tidak mengubah apa pun di D-2.
# Token yang sudah diverifikasi E-1 diteruskan; simulasi autentikasi D-2
# masih menjadi temuan upstream (docs/integrasi/TEMUAN_F1_D2.md).
D2_DRIVER=mock
D2_BASE_URL=http://127.0.0.1:8026
D2_INVOICE_PATH=/api/v1/invoices/{invoiceId}
D2_TIMEOUT=5

# --- Berkas PDF (e-Faktur, e-Billing, bukti pembayaran) ---
E1_UPLOAD_MAX_KB=5120
E1_STORAGE_DISK=local
